# Copy to <settings folder>/forge.env (FORGE_LOCAL names the folder; keep it outside Git).
# KEY=VALUE, no quotes. The flux2-scenery route needs only FORGE_COMFYUI_URL; FORGE_S3_*
# are for `forge asset`, FORGE_SWARMUI_* for `forge image generate`.
FORGE_SWARMUI_URL=http://<gpu-host>:<port>
FORGE_SWARMUI_MODEL=<model file name SwarmUI lists>
FORGE_COMFYUI_URL=http://<gpu-host>:<port>
FORGE_S3_ENDPOINT=http://<storage-host>:<port>
FORGE_S3_BUCKET=<bucket>
FORGE_S3_ACCESS_KEY=<access key>
FORGE_S3_SECRET_KEY=<secret key>
